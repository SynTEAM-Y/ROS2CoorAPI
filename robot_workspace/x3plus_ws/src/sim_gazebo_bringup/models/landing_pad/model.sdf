<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="landing_pad">
    <static>true</static>
    <pose>0 0 0.001 0 0 0</pose>

    <!-- Publish ground-truth pose on /model/landing_pad/pose so the
         vision autopilot can find the pad via TF. static_publisher is
         required because this model is static and never moves. -->
    <plugin filename="ignition-gazebo-pose-publisher-system"
            name="ignition::gazebo::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_rate>5</update_rate>
      <static_publisher>true</static_publisher>
      <static_update_frequency>5</static_update_frequency>
    </plugin>

    <link name="base_link">
      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 0.5 0.002</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.5 0.5 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.8 0.0 1.0</ambient>
          <diffuse>0.0 0.8 0.0 0.6</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
