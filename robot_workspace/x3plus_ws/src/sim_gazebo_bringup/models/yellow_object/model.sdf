<?xml version="1.0" ?>
<sdf version="1.6">
  <!--
    Yellow drop target for the blue cube.

    Deliberately shaped as a flat circular platform (not a tray/sink) so it
    is visually distinct from the sink.  The cube is released onto the top
    surface.  Collision is a matching cylinder that closely follows the
    visual geometry.
  -->
  <model name="yellow_object">
    <static>true</static>
    <pose>0 0 0.0025 0 0 0</pose>

    <plugin filename="ignition-gazebo-pose-publisher-system"
            name="ignition::gazebo::systems::PosePublisher">
      <!-- Publish on the standard /model/<name>/pose topic so the launch
           file's bridge can merge it into /gz_pose_tf.  Static publisher
           would emit on pose_static, which the bridge does not listen to. -->
      <topic>/model/yellow_object/pose</topic>
      <publish_link_pose>false</publish_link_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_rate>5</update_rate>
      <static_publisher>false</static_publisher>
    </plugin>

    <link name="base_link">
      <collision name="collision">
        <pose>0 0 0.0025 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0.0025 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.9 0.0 1.0</ambient>
          <diffuse>1.0 0.9 0.0 1.0</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
