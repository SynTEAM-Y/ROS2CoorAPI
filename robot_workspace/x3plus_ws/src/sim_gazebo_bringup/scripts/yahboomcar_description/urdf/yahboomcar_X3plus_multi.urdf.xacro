<?xml version="1.0" encoding="utf-8"?>
<robot name="yahboomcar_X3plus" xmlns:xacro="http://wiki.ros.org/xacro">
    <!-- Material Definitions -->
    <material name="Black">
        <color rgba="0.0 0.0 0.0 1.0"/>
    </material>
    <material name="White">
        <color rgba="0.95 0.95 0.95 1.0"/>
    </material>
    <material name="Green">
        <color rgba="0.0 0.8 0.0 1.0"/>
    </material>
    <material name="Red">
        <color rgba="1.0 0.0 0.0 1.0"/>
    </material>
    <material name="DarkGray">
        <color rgba="0.3 0.3 0.3 1.0"/>
    </material>
    
    <!-- XACRO Argument: Robot namespace for multi-robot support -->
    <!-- Default: empty string (no namespace prefix) for single robot -->
    <!-- Usage: xacro file.xacro ns:=robot1/ (for multi-robot with slash at end) -->
    <xacro:arg name="ns" default=""/>  <!-- Default empty namespace -->
    <xacro:property name="ns" value="$(arg ns)"/>
    <link name="base_footprint"/>
    <link name="imu_link"/>
    <!-- common link-->
    <xacro:macro name="common_link" params="name material path *origin">
        <link name="${name}">
            <visual>
                <geometry>
                    <mesh filename="package://sim_gazebo_bringup/meshes/${path}/visual/${name}.STL"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <material name="${material}"/>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://sim_gazebo_bringup/meshes/${path}/collision/${name}.STL"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </collision>
            <xacro:insert_block name="origin"/>
        </link>
    </xacro:macro>
    <xacro:macro name="common_link_no_collision" params="name material path *origin">
        <link name="${name}">
            <visual>
                <geometry>
                    <mesh filename="package://sim_gazebo_bringup/meshes/${path}/visual/${name}.STL"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <material name="${material}"/>
            </visual>
            <xacro:insert_block name="origin"/>
        </link>
    </xacro:macro>
    <!-- revolute joint-->
    <xacro:macro name="revolute_joint" params="name parent child xyz rpy axisZ lower upper">
        <joint name="${ns}/${name}" type="revolute">
            <parent link="${ns}/${parent}"/>
            <child link="${ns}/${child}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <axis xyz="0 0 ${axisZ}"/>
            <limit lower="${lower}" upper="${upper}" effort="100" velocity="6"/>
            <!-- Damping/friction added so arm joints absorb their own motion reactions
                 instead of jerking the base around in Gazebo. -->
            <dynamics damping="0.5" friction="0.1"/>
        </joint>
    </xacro:macro>

    <!-- Gripper finger joint macro.
         <mimic> tags are emitted so robot_state_publisher can compute finger
         link TF positions (rlink2/llink2 etc.) from the master grip_joint.
         Ignition Fortress ignores <mimic> for physics — actual finger motion
         is driven by per-joint JointPositionController plugins fed by
         gripper_mimic_relay. The relay also strips mimic joints from
         /joint_states_raw so RSP recomputes them from the URDF <mimic>. -->
    <xacro:macro name="continuous_joint" params="name parent child xyz rpy mimic">
        <joint name="${ns}/${name}" type="revolute">
            <parent link="${ns}/${parent}"/>
            <child link="${ns}/${child}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <axis xyz="0 0 1"/>
            <!-- The mimic relationship is multiplier = -1 or +1.
                 When grip_joint is at the URDF OPEN limit (q=-1.57), a
                 mimic=-1 joint is commanded to +1.57, and a mimic=+1
                 joint is commanded to -1.57.  The previous upper=0.45
                 capped these joints, breaking the mimic constraint and
                 causing the pads to tilt out of plane (the "detached
                 pads" you saw in the sim).  Upper must be >= +pi/2 so
                 the mimic can reach its commanded angle across the full
                 grip_joint range.
                 Widened to +/-pi (was +/-pi/2): the mimics are commanded to
                 +/-1.54 rad, only 0.03 rad below a +/-pi/2 limit.  With any
                 PID overshoot the joint hit the limit and the integrator
                 wound up against it, FREEZING the finger while the rest of
                 the gripper kept moving (the "splayed/detached pad" you saw).
                 A +/-pi limit leaves ~1.6 rad of head-room so the finger
                 never reaches a stop during normal open/close. -->
            <limit lower="-${pi}" upper="${pi}" effort="5" velocity="5"/>
            <!-- Damping/friction matched to grip_joint (which works correctly).
                 Previous values (damping=0.5, friction=0.05) were 100x stronger
                 than the per-joint PID's max torque (1 N.m) could overcome on
                 tiny 1-gram finger links, so 4 of 5 mimic joints stayed frozen
                 while only rlink_joint2 (under load asymmetry) overshot. -->
            <dynamics damping="0.05" friction="0.005"/>
            <!-- <mimic> tag: required by robot_state_publisher to compute finger
                 link TF positions from the master grip_joint. Ignition Fortress
                 ignores <mimic> for physics (handled by JointPositionController
                 plugins + gripper_mimic_relay), but RSP needs it to publish
                 rlink2/llink2 frames in the TF tree. -->
            <mimic joint="grip_joint" multiplier="${mimic}" offset="0"/>
        </joint>
    </xacro:macro>

    <!-- fixed joint-->
    <xacro:macro name="fixed_joint" params="name parent child xyz rpy">
        <joint name="${ns}/${name}" type="fixed">
            <parent link="${ns}/${parent}"/>
            <child link="${ns}/${child}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
        </joint>
    </xacro:macro>

    <!-- ==================== WHEEL LINKS AND JOINTS MACROS ==================== -->
    <!-- CONFIGURABLE WHEEL PARAMETERS -->
    <!-- Wheel Radius: 0.04 = 8cm diameter wheel. Change to match your actual wheel size. -->
    <!-- Wheel Width: 0.015 = 1.5cm thickness. Adjust for wide/narrow wheels. -->
    <!-- Wheel Mass: 0.1 = 100 grams per wheel. Heavier wheels = better traction, slower response. -->
    <!-- Wheel Inertia: Automatically calculated from radius and mass (I = (1/12)*m*(3*r^2 + h^2)) -->
    
    <!-- Wheel link: visual = two-piece separated wheel mesh (tire + rim) so the
         wheel rotation is clearly visible. Collision = simple cylinder (fast/stable
         physics; mesh-on-mesh wheel collision is unreliable in Ignition).
         mesh_prefix = fl|fr|bl|br (selects the matching mesh files in meshes/wheels/).
         mesh_xyz    = visual <origin> needed to recenter the mesh on the wheel link.
                       The source LinkForge URDF baked the wheel's world coordinates
                       into the mesh geometry (joint at origin, visual offset to
                       wheel position). To use the meshes with our wheel_joint
                       (which puts the link AT the wheel position), we negate the
                       authored offset so the mesh content lands on the link origin. -->
    <xacro:macro name="wheel_link" params="name mass mesh_prefix mesh_xyz">
        <link name="${ns}/${name}">
            <inertial>
                <mass value="${mass}"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <inertia ixx="0.000067" ixy="0" ixz="0" iyy="0.000067" iyz="0" izz="0.000032"/>
            </inertial>
            <!-- Only the *_visual_1.stl (~2 MB) is the correct full wheel mesh.
                 The *_visual_0.stl is a small inner part that doesn't belong here. -->
            <visual>
                <geometry>
                    <mesh filename="package://yahboomcar_description/meshes/wheels/${mesh_prefix}_wheel_link_visual_visual_1.stl"/>
                </geometry>
                <origin xyz="${mesh_xyz}" rpy="0 0 0"/>
                <material name="Black"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.04" length="0.015"/>
                </geometry>
                <origin xyz="0 0 0" rpy="1.5707 0 0"/>
            </collision>
        </link>
    </xacro:macro>

    <!-- Macro to create wheel joint with continuous rotation for differential drive -->
    <xacro:macro name="wheel_joint" params="name parent child x_pos y_pos">
        <joint name="${ns}/${name}" type="continuous">
            <parent link="${ns}/${parent}"/>
            <child link="${ns}/${child}"/>
            <!-- WHEEL POSITION CONFIGURATION:
                 - x_pos: Forward/backward from base_link center (0.05 = 5cm forward)
                 - y_pos: Left/right position. Positive = right, negative = left
                 - Z position: Automatically set to -0.036 (wheel radius 0.04m - 0.004m clearance)
                 EDIT x_pos AND y_pos VALUES TO ADJUST WHEEL PLACEMENT -->
            <origin xyz="${x_pos} ${y_pos} -0.036" rpy="0 0 0"/>
            <!-- Rotation axis: 0 1 0 = Y-axis rotation (wheels spin side-to-side) -->
            <axis xyz="0 1 0"/>
            <!-- MOTOR TORQUE LIMIT (effort): N⋅m. -->
            <!-- MOTOR SPEED LIMIT (velocity): rad/s. With wheel_radius=0.04 m,
                 max linear speed = velocity * 0.04. Old value (2 rad/s) capped the
                 robot at 0.08 m/s, making it look almost stationary. 30 rad/s
                 -> ~1.2 m/s ceiling, comfortably above commanded 0.8 m/s. -->
            <limit effort="10" velocity="30"/>
            <dynamics damping="0.1" friction="0.0"/>
        </joint>
    </xacro:macro>

    <!-- base_link: visual uses chassis mesh; collision is a SIMPLE BOX positioned ABOVE
         the wheel contact line. The original chassis collision mesh extended downward
         past the wheel bottoms, lifting wheels off the ground (chassis rested on its
         own body, wheels spun in air, robot didn't move). -->
    <link name="base_link">
        <visual>
            <!-- New chassis mesh WITHOUT the molded-in wheels (the old
                 base_link.STL had the wheels baked into the chassis, which
                 made the separated wheel meshes appear duplicated). The mesh
                 was authored at a different origin offset; the visual <origin>
                 below restores its placement on top of base_link. -->
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/X3plus/visual/base_link_no_wheels.STL"/>
            </geometry>
            <origin xyz="-0.005345 0 0.169" rpy="0 0 0"/>
            <material name="Green"/>
        </visual>
        <collision>
            <!-- Box: 24cm long x 18cm wide x 8cm tall, centered 4cm above base_link
                 origin (which itself is 7.6cm above ground). Bottom of box sits at
                 z=0.076 m world, well above wheel tops at z=0.08 m. -->
            <geometry>
                <box size="0.24 0.18 0.08"/>
            </geometry>
            <origin xyz="-0.02 0 0.04" rpy="0 0 0"/>
        </collision>
        <inertial>
            <origin xyz="-0.0304416859098744 4.23384368655101E-05 0.0448234503408059" rpy="0 0 0"/>
            <!-- Increased to 8.0 kg (was 4.0). The arm + gripper assembly
                 creates a forward-tipping moment at REACH_DOWN; the chassis
                 alone is too light to resist the gripper's contact reaction
                 force at the cube/sink. Doubling the base mass quadruples
                 the rotational inertia about y, so the robot stays planted
                 while the gripper presses against the target. The iyy was
                 scaled by 2x (proportional to mass). -->
            <mass value="8.0"/>
            <inertia
                    ixx="0.156"
                    ixy="2.4618093127858E-06"
                    ixz="0.0458"
                    iyy="0.1976"
                    iyz="-1.10079499865282E-06"
                    izz="0.0964"/>
        </inertial>
    </link>
    <xacro:fixed_joint name="base_joint" parent="base_footprint" child="base_link" xyz="0.0 0.0 0.076" rpy="0 0 0"/>
    <xacro:fixed_joint name="base_imu" parent="base_link" child="imu_link" xyz="0.001 0.017 0.0322" rpy="0 3.1415 1.5707"/>

    <!-- ==================== 4-WHEEL DRIVE WITH STEPPER MOTORS ==================== -->
    <!-- CONFIGURABLE: Wheel Mass (kg). Default 0.1 = 100 grams each wheel -->
    <!-- Change for heavier/lighter wheels. More mass = better traction but slower acceleration -->
    <!-- New wheel STLs are authored centered on the origin (verified bbox
         x:±0.04, y:±0.0187, z:±0.04), so mesh_xyz=0 0 0. Earlier non-zero
         offsets pushed the visual ~10 cm away from the link → wheels invisible. -->
    <xacro:wheel_link name="front_left_wheel"  mass="0.1" mesh_prefix="fl" mesh_xyz="0 0 0"/>
    <xacro:wheel_link name="front_right_wheel" mass="0.1" mesh_prefix="fr" mesh_xyz="0 0 0"/>
    <xacro:wheel_link name="back_left_wheel"   mass="0.1" mesh_prefix="bl" mesh_xyz="0 0 0"/>
    <xacro:wheel_link name="back_right_wheel"  mass="0.1" mesh_prefix="br" mesh_xyz="0 0 0"/>

    <!-- CONFIGURABLE: Wheel Positions (4-wheel configuration) -->
    <!-- Front wheels: x_pos=0.05 (5cm forward - matches original 2-wheel position) -->
    <!-- Back wheels: x_pos=-0.08 (8cm backward from center) -->
    <!-- Left wheels: y_pos=0.08 (8cm to the left) -->
    <!-- Right wheels: y_pos=-0.08 (8cm to the right) -->
    <!-- Total wheelbase: 13cm, track width: 16cm -->
    <xacro:wheel_joint name="front_left_wheel_joint" parent="base_link" child="front_left_wheel" x_pos="0.1054" y_pos="0.1064"/>
    <xacro:wheel_joint name="front_right_wheel_joint" parent="base_link" child="front_right_wheel" x_pos="0.1054" y_pos="-0.1064"/>
    <xacro:wheel_joint name="back_left_wheel_joint" parent="base_link" child="back_left_wheel" x_pos="-0.1146" y_pos="0.1064"/>
    <xacro:wheel_joint name="back_right_wheel_joint" parent="base_link" child="back_right_wheel" x_pos="-0.1146" y_pos="-0.1064"/>

    <!-- GAZEBO FRICTION PROPERTIES FOR ALL 4 WHEELS -->
    <!-- FRONT wheels = driven by DiffDrive plugin → high friction for traction.
         BACK wheels  = passive (free-spinning) → LOW friction so they don't fight
         the chassis during in-place yaw rotation. With high friction on all 4 wheels
         the back pair anchors the chassis and the robot just rocks instead of turning.
         Removed <fdir1> — in Ignition Fortress it does not reliably set the friction
         axis the way Gazebo Classic did. -->
    <gazebo reference="front_left_wheel">
        <material>Gazebo/DarkGrey</material>
        <visual>
            <material>
                <ambient>0.2 0.2 0.2 1</ambient>
                <diffuse>0.2 0.2 0.2 1</diffuse>
                <specular>0.2 0.2 0.2 1</specular>
            </material>
        </visual>
        <mu1>2.0</mu1>
        <mu2>2.0</mu2>
        <kp>200000.0</kp>
        <kd>50.0</kd>
    </gazebo>

    <gazebo reference="front_right_wheel">
        <material>Gazebo/DarkGrey</material>
        <visual>
            <material>
                <ambient>0.2 0.2 0.2 1</ambient>
                <diffuse>0.2 0.2 0.2 1</diffuse>
                <specular>0.2 0.2 0.2 1</specular>
            </material>
        </visual>
        <mu1>2.0</mu1>
        <mu2>2.0</mu2>
        <kp>200000.0</kp>
        <kd>50.0</kd>
    </gazebo>

    <gazebo reference="back_left_wheel">
        <material>Gazebo/DarkGrey</material>
        <visual>
            <material>
                <ambient>0.2 0.2 0.2 1</ambient>
                <diffuse>0.2 0.2 0.2 1</diffuse>
                <specular>0.2 0.2 0.2 1</specular>
            </material>
        </visual>
        <mu1>2.0</mu1>
        <mu2>2.0</mu2>
        <kp>200000.0</kp>
        <kd>50.0</kd>
    </gazebo>

    <gazebo reference="back_right_wheel">
        <material>Gazebo/DarkGrey</material>
        <visual>
            <material>
                <ambient>0.2 0.2 0.2 1</ambient>
                <diffuse>0.2 0.2 0.2 1</diffuse>
                <specular>0.2 0.2 0.2 1</specular>
            </material>
        </visual>
        <mu1>2.0</mu1>
        <mu2>2.0</mu2>
        <kp>200000.0</kp>
        <kd>50.0</kd>
    </gazebo>

    <xacro:common_link name="laser_link" material="DarkGray" path="sensor_X3plus">
        <inertial>
            <origin xyz="-0.0176558922685589 0.000671805271544437 0.0219302095894866" rpy="0 0 0"/>
            <mass value="0.0483909504209895"/>
            <inertia ixx="1.58456966399128E-05" ixy="-4.23913983850005E-07" ixz="-2.09597897904374E-07"
                     iyy="3.89262522903605E-05" iyz="3.24809725932687E-07" izz="4.86230801106223E-05"/>
        </inertial>
    </xacro:common_link>
    <xacro:fixed_joint name="laser_joint" parent="base_link" child="laser_link" xyz="0.10478 0 0.0471" rpy="0 0 0"/>
    
    <xacro:common_link name="camera_link" material="DarkGray" path="sensor_X3plus">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
    </xacro:common_link>
    <xacro:fixed_joint name="camera_joint" parent="base_link" child="camera_link" xyz="-0.043645 0 0.41955" rpy="0 0 0"/>

    <xacro:common_link name="arm_link1" material="DarkGray" path="X3plus">
        <inertial>
            <origin xyz="1.99179507982521E-05 -5.98354652829568E-05 0.0114289358828097" rpy="0 0 0"/>
            <mass value="0.0279545499871709"/>
            <inertia
                    ixx="1.19144359314975E-05"
                    ixy="-9.26068510046816E-09"
                    ixz="3.16060516198683E-09"
                    iyy="1.05642517915377E-05"
                    iyz="2.69674403668579E-08"
                    izz="1.49639510661413E-05"/>
        </inertial>
    </xacro:common_link>
    <xacro:revolute_joint name="arm_joint1" parent="base_link" child="arm_link1" xyz="0.09825 0 0.102" rpy="0 0 0" axisZ="-1"
                    lower="-${pi/2}" upper="${pi/2}"/>
    <xacro:common_link name="arm_link2" material="Green" path="X3plus">
        <inertial>
            <origin xyz="0.024903 -0.0022632 -0.00066663" rpy="0 0 0"/>
            <mass value="0.031605"/>
            <inertia
                    ixx="5.8495E-06"
                    ixy="-8.8092E-07"
                    ixz="1.5336E-07"
                    iyy="2.667E-05"
                    iyz="7.1365E-09"
                    izz="2.4695E-05"/>
        </inertial>
    </xacro:common_link>
    <xacro:revolute_joint name="arm_joint2" parent="arm_link1" child="arm_link2" xyz="0 0 0.0405"
                    rpy="-${pi/2} 0 0" axisZ="-1" lower="-${pi/2}" upper="${pi/2}"/>
    <xacro:common_link name="arm_link3" material="DarkGray" path="X3plus">
        <inertial>
            <origin xyz="0.024903 -0.0022634 -0.0013962" rpy="0 0 0"/>
            <mass value="0.031605"/>
            <inertia
                    ixx="5.8492E-06"
                    ixy="-8.8063E-07"
                    ixz="1.4331E-07"
                    iyy="2.667E-05"
                    iyz="8.9675E-09"
                    izz="2.4695E-05"/>
        </inertial>
    </xacro:common_link>
    <xacro:revolute_joint name="arm_joint3" parent="arm_link2" child="arm_link3" xyz="0 -0.0829 0" rpy="0 0 0"
                    axisZ="-1" lower="-${pi/2}" upper="${pi/2}"/>
    <xacro:common_link name="arm_link4" material="Green" path="X3plus">
        <inertial>
            <origin xyz="0.036246 0.0023413 -0.0019655" rpy="0 0 0"/>
            <mass value="0.049766"/>
            <inertia
                    ixx="1.1857E-05"
                    ixy="-6.5371E-06"
                    ixz="-4.1044E-08"
                    iyy="3.6323E-05"
                    iyz="-1.2132E-07"
                    izz="4.1769E-05"/>
        </inertial>
    </xacro:common_link>
    <xacro:revolute_joint name="arm_joint4" parent="arm_link3" child="arm_link4" xyz="0 -0.0829 0" rpy="0 0 0"
                    axisZ="-1" lower="-${pi/2}" upper="${pi/2}"/>
    <xacro:common_link_no_collision name="arm_link5" material="Red" path="X3plus">
        <inertial>
            <origin xyz="0.0023228 0.018169 0.028684" rpy="0 0 0"/>
            <mass value="0.04069"/>
            <inertia
                    ixx="1.0627E-05"
                    ixy="-3.0402E-07"
                    ixz="-1.9524E-07"
                    iyy="9.6306E-06"
                    iyz="-1.3265E-06"
                    izz="1.3298E-05"/>
        </inertial>
    </xacro:common_link_no_collision>
    <xacro:revolute_joint name="arm_joint5" parent="arm_link4" child="arm_link5" xyz="-0.00215 -0.17455 0"
                    rpy="${pi/2} 0 0" axisZ="1" lower="-${pi/2}" upper="${pi}"/>

    <xacro:common_link_no_collision name="rlink1" material="Green" path="X3plus">
        <inertial>
            <origin xyz="0.00653227489887718 0.000416767821288678 0.000980984132845697" rpy="0 0 0"/>
            <mass value="0.00117883201961805"/>
            <!-- Inertia bumped from ~1e-7 -> 1e-5 to keep PID-controlled mimic
                 motion numerically stable in Ignition (the original CAD inertia
                 was too small for any applied torque). -->
            <inertia ixx="1.0E-5" ixy="0" ixz="0" iyy="1.0E-5" iyz="0" izz="1.0E-5"/>
        </inertial>
    </xacro:common_link_no_collision>
    <!-- grip_joint: inlined (NOT using revolute_joint macro) so we can apply
         very low damping/friction. The driven link rlink1 has tiny inertia
         (~1e-7 kg.m²); the macro's damping=1.0/friction=0.5 over-damps it and
         the PID controller cannot move the joint.
         Upper limit 0.35 → 1.30 rad so the gripper can close to the
         2.8 cm Y-diff target (cmd ≈ 1.207).  At cmd=0 the pad gap is
         ~27 mm; at cmd=+1.207 the pads close to ~28 mm (2.8 cm) — the
         user explicitly wanted "2.8 CM BETWEEN R-L LINK_JOINT2" rather
         than the cube-tight 2.0 cm grip.  Pads no longer over-close on
         the cube; they sit at the configured 2.8 cm gap. -->
    <joint name="${ns}/grip_joint" type="revolute">
        <parent link="${ns}/arm_link5"/>
        <child link="${ns}/rlink1"/>
        <origin xyz="-0.0035 -0.012625 -0.0685" rpy="0 -${pi/2} 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.8" upper="0.45" effort="100" velocity="5"/>
        <dynamics damping="0.05" friction="0.005"/>
    </joint>
    <xacro:common_link name="rlink2" material="Green" path="X3plus">
        <inertial>
            <origin xyz="0.021158 0.0063295 -0.0030251" rpy="0 0 0"/>
            <mass value="0.0024469"/>
            <inertia ixx="1.0E-5" ixy="0" ixz="0" iyy="1.0E-5" iyz="0" izz="1.0E-5"/>
        </inertial>
    </xacro:common_link>
    <xacro:continuous_joint name="rlink_joint2" parent="rlink1" child="rlink2" xyz="0.03 -0.00075429 0" rpy="0 0 0" mimic="-1"/>

    <!-- rlink3 / rlink_joint3: RIGHT 4-bar ROCKER.
         Parented to arm_link5 and driven by mimic=+1 so it rotates by
         the same angle as the input crank rlink1.  Together with the
         rlink_joint2 mimic this forms the parallelogram four-bar that
         keeps the pad parallel through the whole grip range.

         The rocker is pinned at arm_link5 (C, this joint origin) and
         its free end tracks the pad's middle hole via the mimic
         relationship.  Positions match the original yahboomcar
         URDF which works correctly in RViz. -->
    <xacro:common_link_no_collision name="rlink3" material="Green" path="X3plus">
        <inertial>
            <origin xyz="0.014355 1.1499E-05 -0.0033992" rpy="0 0 0"/>
            <mass value="0.00087627"/>
            <inertia ixx="1.0E-5" ixy="0" ixz="0" iyy="1.0E-5" iyz="0" izz="1.0E-5"/>
        </inertial>
    </xacro:common_link_no_collision>
    <xacro:continuous_joint name="rlink_joint3" parent="arm_link5" child="rlink3" xyz="-0.0035 -0.0045 -0.0505"
                      rpy="0 -${pi/2} 0" mimic="1"/>
    <xacro:common_link_no_collision name="llink1" material="Green" path="X3plus">
        <inertial>
            <origin xyz="0.00628617364795481 -0.000318530407893543 0.00100000338924466" rpy="0 0 0"/>
            <mass value="0.00121010771282268"/>
            <inertia ixx="1.0E-5" ixy="0" ixz="0" iyy="1.0E-5" iyz="0" izz="1.0E-5"/>
        </inertial>
    </xacro:common_link_no_collision>
    <xacro:continuous_joint name="llink_joint1" parent="arm_link5" child="llink1" xyz="-0.0035 0.012375 -0.0685"
                      rpy="0 -${pi/2} 0" mimic="-1"/>
    <xacro:common_link name="llink2" material="Green" path="X3plus">
        <inertial>
            <origin xyz="0.021159 -0.0063248 -0.0030251" rpy="0 0 0"/>
            <mass value="0.0024469"/>
            <inertia ixx="1.0E-5" ixy="0" ixz="0" iyy="1.0E-5" iyz="0" izz="1.0E-5"/>
        </inertial>
    </xacro:common_link>
    <xacro:continuous_joint name="llink_joint2" parent="llink1" child="llink2" xyz="0.03 0.00065104 0" rpy="0 0 0"
                      mimic="1"/>

    <!-- llink3 / llink_joint3: LEFT 4-bar ROCKER, mirror of the right side.
         Mirror of the right rocker with Y axis flipped.  mimic=-1 so the
         left rocker stays parallel to the left input crank. -->
    <xacro:common_link_no_collision name="llink3" material="Green" path="X3plus">
        <inertial>
            <origin xyz="0.014354 -7.4795E-05 -0.0033992" rpy="0 0 0"/>
            <mass value="0.00087627"/>
            <inertia ixx="1.0E-5" ixy="0" ixz="0" iyy="1.0E-5" iyz="0" izz="1.0E-5"/>
        </inertial>
    </xacro:common_link_no_collision>
    <xacro:continuous_joint name="llink_joint3" parent="arm_link5" child="llink3" xyz="-0.0035 0.0045 -0.0505"
                      rpy="0 -${pi/2} 0" mimic="-1"/>

    <xacro:common_link name="mono_link" material="DarkGray" path="sensor_X3plus">
        <inertial>
            <origin xyz="5.8458E-05 0.0095015 -0.0014824" rpy="0 0 0"/>
            <mass value="0.0097589"/>
            <inertia ixx="3.3488E-06" ixy="1.3667E-08" ixz="6.4235E-09" iyy="1.8662E-06" iyz="-1.0265E-07"
                     izz="2.5696E-06"/>
        </inertial>
    </xacro:common_link>
    <xacro:fixed_joint name="mono_joint" parent="arm_link4" child="mono_link" xyz="-0.0481 -0.05145 -0.0022"
                 rpy="${pi/2} 0 0"/>

    <!-- ==================== ARM INITIAL POSITIONS FOR GAZEBO ==================== -->
    <!-- Set default joint positions to match RViz (all at 0 radians) -->
    <gazebo reference="arm_joint1">
        <implicitSpringDamper>true</implicitSpringDamper>
        <initial_position>0</initial_position>
    </gazebo>
    <gazebo reference="arm_joint2">
        <implicitSpringDamper>true</implicitSpringDamper>
        <initial_position>0</initial_position>
    </gazebo>
    <gazebo reference="arm_joint3">
        <implicitSpringDamper>true</implicitSpringDamper>
        <initial_position>0</initial_position>
    </gazebo>
    <gazebo reference="arm_joint4">
        <implicitSpringDamper>true</implicitSpringDamper>
        <initial_position>0</initial_position>
    </gazebo>
    <gazebo reference="arm_joint5">
        <implicitSpringDamper>true</implicitSpringDamper>
        <initial_position>0</initial_position>
    </gazebo>

    <!-- ==================== ARM JOINT POSITION CONTROLLERS (IGNITION) ==================== -->
    <!-- Without these, gravity makes the arm collapse on spawn.                            -->
    <!-- Each JointPositionController is a PID that holds the joint at a commanded angle.  -->
    <!-- Commands come in as ignition.msgs.Double on /<joint>_cmd_pos and are bridged from -->
    <!-- ROS std_msgs/Float64 topics published by the existing arm_controller node.        -->
    <gazebo>
        <plugin filename="ignition-gazebo-joint-position-controller-system"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>arm_joint1</joint_name>
            <topic>/arm_joint1_cmd_pos</topic>
            <p_gain>8</p_gain> <i_gain>0.0</i_gain> <d_gain>0.5</d_gain>
            <i_max>0.2</i_max> <i_min>-0.5</i_min>
            <cmd_max>5</cmd_max> <cmd_min>-5</cmd_min>
            <initial_position>0</initial_position>
        </plugin>
        <plugin filename="ignition-gazebo-joint-position-controller-system"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>arm_joint2</joint_name>
            <topic>/arm_joint2_cmd_pos</topic>
            <p_gain>10</p_gain> <i_gain>0.0</i_gain> <d_gain>0.5</d_gain>
            <i_max>0.2</i_max> <i_min>-0.5</i_min>
            <cmd_max>8</cmd_max> <cmd_min>-8</cmd_min>
            <initial_position>0</initial_position>
        </plugin>
        <plugin filename="ignition-gazebo-joint-position-controller-system"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>arm_joint3</joint_name>
            <topic>/arm_joint3_cmd_pos</topic>
            <p_gain>10</p_gain> <i_gain>0.0</i_gain> <d_gain>0.5</d_gain>
            <i_max>0.2</i_max> <i_min>-0.5</i_min>
            <cmd_max>6</cmd_max> <cmd_min>-6</cmd_min>
            <initial_position>0</initial_position>
        </plugin>
        <plugin filename="ignition-gazebo-joint-position-controller-system"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>arm_joint4</joint_name>
            <topic>/arm_joint4_cmd_pos</topic>
            <p_gain>8</p_gain> <i_gain>0.0</i_gain> <d_gain>0.5</d_gain>
            <i_max>0.2</i_max> <i_min>-0.5</i_min>
            <cmd_max>5</cmd_max> <cmd_min>-5</cmd_min>
            <initial_position>0</initial_position>
        </plugin>
        <plugin filename="ignition-gazebo-joint-position-controller-system"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>arm_joint5</joint_name>
            <topic>/arm_joint5_cmd_pos</topic>
            <p_gain>6</p_gain> <i_gain>0.0</i_gain> <d_gain>0.5</d_gain>
            <i_max>0.2</i_max> <i_min>-0.5</i_min>
            <cmd_max>3</cmd_max> <cmd_min>-3</cmd_min>
            <initial_position>0</initial_position>
        </plugin>
        <plugin filename="ignition-gazebo-joint-position-controller-system"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>grip_joint</joint_name>
            <topic>/grip_master_target</topic>
            <!-- i_gain MUST stay 0: the mimic fingers are commanded close to
                 the joint limit; any integral term winds up against that stop
                 and freezes the finger (the splayed-gripper bug).  Pure P+D
                 position-following is enough for the ~1 g finger links and the
                 cube grip is a spring grip (P-term) that needs no integral. -->
            <p_gain>40.0</p_gain> <i_gain>0.0</i_gain>  <d_gain>2.0</d_gain>
            <i_max>0.2</i_max> <i_min>-0.2</i_min>
            <cmd_max>5.0</cmd_max> <cmd_min>-5.0</cmd_min>
            <!-- Home position is CLOSED (0.0).  Pads start together so the
                 gripper is ready to receive a cube. -->
            <initial_position>0</initial_position>
        </plugin>
        <!-- ==================== MIMIC GRIPPER FINGER CONTROLLERS ====================
              Ignition Fortress does NOT enforce URDF <mimic>. To make the fingers
              actually open/close in Gazebo (not just visually in RViz/RSP), we
              attach a low-gain JointPositionController to each of the 3 mimic
              joints (rlink_joint2, llink_joint1, llink_joint2). The
              gripper_mimic_relay node fans out /grip_joint_cmd_pos to each
              /<mimic>_cmd_pos topic with the URDF multiplier baked in.
              Finger inertias are bumped to 1e-5 (above) and gravity is disabled
              on the finger links (below) so these tiny PID loops stay stable. -->
        <!-- MIMIC GRIPPER FINGER CONTROLLERS (5 mimic joints).
             rlink_joint3 and llink_joint3 are the 4-bar COUPLERS (rockers).
             All five share the same low-gain PID: p_gain=10, i_gain=0.0 (any
             integral winds up against the joint limit and freezes/splays the
             finger), d_gain=0.3.  The couplers keep the pads parallel and make
             the four-bar visually complete. -->
        <plugin filename="ignition-gazebo-joint-position-controller-system"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>llink_joint1</joint_name>
            <topic>/llink_joint1_cmd_pos</topic>
            <p_gain>40.0</p_gain> <i_gain>0.0</i_gain>  <d_gain>2.0</d_gain>
            <i_max>0.2</i_max> <i_min>-0.2</i_min>
            <cmd_max>5.0</cmd_max> <cmd_min>-5.0</cmd_min>
            <!-- mimic=-1: at master=-1.54 the mimic should be at +1.54.
                 Setting initial to the correct mimic value avoids the
                 sim-start jump that visibly "detaches" the pad. -->
            <initial_position>0</initial_position>
        </plugin>
        <plugin filename="ignition-gazebo-joint-position-controller-system"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>llink_joint2</joint_name>
            <topic>/llink_joint2_cmd_pos</topic>
            <p_gain>40.0</p_gain> <i_gain>0.0</i_gain>  <d_gain>2.0</d_gain>
            <i_max>0.2</i_max> <i_min>-0.2</i_min>
            <cmd_max>5.0</cmd_max> <cmd_min>-5.0</cmd_min>
            <initial_position>0</initial_position>
        </plugin>
        <plugin filename="ignition-gazebo-joint-position-controller-system"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>llink_joint3</joint_name>
            <topic>/llink_joint3_cmd_pos</topic>
            <p_gain>40.0</p_gain> <i_gain>0.0</i_gain>  <d_gain>2.0</d_gain>
            <i_max>0.2</i_max> <i_min>-0.2</i_min>
            <cmd_max>5.0</cmd_max> <cmd_min>-5.0</cmd_min>
            <!-- mimic=-1: at master=-1.54 the mimic should be at +1.54. -->
            <initial_position>0</initial_position>
        </plugin>
        <plugin filename="ignition-gazebo-joint-position-controller-system"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>rlink_joint2</joint_name>
            <topic>/rlink_joint2_cmd_pos</topic>
            <p_gain>40.0</p_gain> <i_gain>0.0</i_gain>  <d_gain>2.0</d_gain>
            <i_max>0.2</i_max> <i_min>-0.2</i_min>
            <cmd_max>5.0</cmd_max> <cmd_min>-5.0</cmd_min>
            <!-- mimic=-1: at master=-1.54 the mimic should be at +1.54. -->
            <initial_position>0</initial_position>
        </plugin>
        <plugin filename="ignition-gazebo-joint-position-controller-system"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>rlink_joint3</joint_name>
            <topic>/rlink_joint3_cmd_pos</topic>
            <p_gain>40.0</p_gain> <i_gain>0.0</i_gain>  <d_gain>2.0</d_gain>
            <i_max>0.2</i_max> <i_min>-0.2</i_min>
            <cmd_max>5.0</cmd_max> <cmd_min>-5.0</cmd_min>
            <initial_position>0</initial_position>
        </plugin>
        <!-- ==================== IGNITION DIFFERENTIAL DRIVE ==================== -->
        <!-- Replaces the Gazebo-Classic libgazebo_ros_diff_drive.so plugin which is
             not loadable in Ignition Gazebo. Listens on /cmd_vel and publishes /odom + TF.
             Only the FRONT wheels are driven; the back wheels roll passively to avoid
             over-constraining the rigid base (driving all four caused ODE AABB asserts). -->
        <plugin filename="ignition-gazebo-diff-drive-system"
                name="ignition::gazebo::systems::DiffDrive">
            <left_joint>front_left_wheel_joint</left_joint>
            <left_joint>back_left_wheel_joint</left_joint>
            <right_joint>front_right_wheel_joint</right_joint>
            <right_joint>back_right_wheel_joint</right_joint>
            <!-- Track width: wheels at y=±0.1064 (from xacro:wheel_joint args).
                 Previous value 0.16 was wrong → plugin under-rotated by 0.16/0.2128
                 = 75% (closed-loop "90°" turn was only ~68°) and odometry yaw drifted. -->
            <wheel_separation>0.2128</wheel_separation>
            <wheel_radius>0.04</wheel_radius>
            <max_linear_acceleration>3.0</max_linear_acceleration>
            <max_angular_acceleration>3.0</max_angular_acceleration>
            <max_linear_velocity>1.5</max_linear_velocity>
            <max_angular_velocity>3.0</max_angular_velocity>
            <!-- IMPORTANT: leading-slash topics like '/cmd_vel' are silently
                 ignored by ignition-gazebo-diff-drive-system in Fortress, which
                 then falls back to its default '/model/<name>/cmd_vel' and never
                 subscribes to '/cmd_vel'. We use the model-namespaced topics
                 here and remap them to /cmd_vel and /odom in the ros_gz_bridge
                 (see sim_gazebo_bringup/launch/gazebo.launch.py). -->
            <topic>/model/x3plus/cmd_vel</topic>
            <odom_topic>/model/x3plus/odometry</odom_topic>
            <tf_topic>/model/x3plus/tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <odom_publish_frequency>30</odom_publish_frequency>
        </plugin>
        <!-- Publishes the actual joint positions from the physics engine so the bridge
             can forward them to ROS /joint_states (replacing the static publisher).      -->
        <plugin filename="ignition-gazebo-joint-state-publisher-system"
                name="ignition::gazebo::systems::JointStatePublisher">
            <update_rate>50</update_rate>
        </plugin>
        <!-- Required for the IMU sensor below to publish data. Without it the
             /imu topic exists in Ignition but is never updated. -->
        <plugin filename="ignition-gazebo-imu-system"
                name="ignition::gazebo::systems::Imu">
        </plugin>
        <!-- Required for the contact sensors on the gripper fingers to detect
             collision with the object being grasped. -->
        <plugin filename="ignition-gazebo-contact-system"
                name="ignition::gazebo::systems::Contact">
        </plugin>
        <!-- Publishes the model's world pose so we can relay it into ROS /tf
             as odom->base_footprint and keep RViz matched to Gazebo physics. -->
        <plugin filename="ignition-gazebo-pose-publisher-system"
                name="gz::sim::systems::PosePublisher">
            <topic>/model/x3plus/pose</topic>
            <publish_link_pose>true</publish_link_pose>
            <publish_collision_pose>false</publish_collision_pose>
            <publish_visual_pose>false</publish_visual_pose>
            <publish_nested_model_pose>false</publish_nested_model_pose>
        </plugin>
    </gazebo>

    <!-- IMU sensor on the chassis. Publishes real chassis orientation (not
         wheel-odom integration), used by manual_control's closed-loop 90° turn
         so the turn stops at the actual heading regardless of wheel slip. -->
    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>100</update_rate>
            <visualize>false</visualize>
            <topic>/model/x3plus/imu</topic>
        </sensor>
    </gazebo>

    <!-- Depth camera on camera_link disabled to optimize CPU/GPU rendering resources in multi-robot mode -->
    <!--
    <gazebo reference="camera_link">
        <sensor name="depth_camera" type="rgbd">
            <always_on>1</always_on>
            <update_rate>5.0</update_rate>
            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <width>320</width>
                    <height>240</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>10.0</far>
                </clip>
            </camera>
            <topic>/depth_camera</topic>
        </sensor>
    </gazebo>
    -->

    <!-- Wrist monocular camera on mono_link -->
    <gazebo reference="mono_link">
        <sensor name="wrist_mono_camera" type="camera">
            <always_on>1</always_on>
            <update_rate>5.0</update_rate>
            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <width>320</width>
                    <height>240</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>10.0</far>
                </clip>
            </camera>
            <topic>/wrist_mono_camera</topic>
        </sensor>
    </gazebo>

    <!-- Enable gravity on the passive mimic gripper links so they do not flop in Gazebo.
         Mimic constraints are not enforced by Ignition physics, but with gravity off
         these links remain at their spawn pose instead of falling free.
         collide_bitmask=0xFF enables collision with everything so the fingers
         can actually grip the cube.  mu1=mu2=30.0 provides high friction to
         prevent the cube from sliding.                                       -->
    <gazebo reference="llink1"><gravity>0</gravity><mu1>10.0</mu1><mu2>10.0</mu2><collision><surface><contact><collide_bitmask>0xFF</collide_bitmask></contact></surface></collision></gazebo>
    <gazebo reference="llink2"><gravity>0</gravity><mu1>10.0</mu1><mu2>10.0</mu2><collision><surface><contact><collide_bitmask>0xFF</collide_bitmask></contact></surface></collision></gazebo>
    <gazebo reference="llink3"><gravity>0</gravity><mu1>10.0</mu1><mu2>10.0</mu2><collision><surface><contact><collide_bitmask>0xFF</collide_bitmask></contact></surface></collision></gazebo>
    <gazebo reference="rlink1"><gravity>0</gravity><mu1>10.0</mu1><mu2>10.0</mu2><collision><surface><contact><collide_bitmask>0xFF</collide_bitmask></contact></surface></collision></gazebo>
    <gazebo reference="rlink2"><gravity>0</gravity><mu1>10.0</mu1><mu2>10.0</mu2><collision><surface><contact><collide_bitmask>0xFF</collide_bitmask></contact></surface></collision></gazebo>
    <gazebo reference="rlink3"><gravity>0</gravity><mu1>10.0</mu1><mu2>10.0</mu2><collision><surface><contact><collide_bitmask>0xFF</collide_bitmask></contact></surface></collision></gazebo>

    <!-- Contact sensors on the gripper finger pads (llink2, rlink2) to detect
         collision with the object during grasping. The pick_and_place node
         subscribes to these topics and stops the gripper closing when contact
         is detected. -->
    <gazebo reference="llink2">
        <sensor name="llink2_contact" type="contact">
            <always_on>true</always_on>
            <update_rate>20</update_rate>
            <topic>/model/x3plus/contact/llink2</topic>
            <contact>
            </contact>
        </sensor>
    </gazebo>
    <gazebo reference="rlink2">
        <sensor name="rlink2_contact" type="contact">
            <always_on>true</always_on>
            <update_rate>20</update_rate>
            <topic>/model/x3plus/contact/rlink2</topic>
            <contact>
            </contact>
        </sensor>
    </gazebo>


    <!-- ==================== LEGACY GAZEBO CLASSIC DIFF DRIVE (DISABLED) ==================== -->
    <!-- The old Gazebo Classic libgazebo_ros_diff_drive.so plugin is not loadable in
         Ignition Gazebo. The active wheel controller is the ignition-gazebo-diff-drive-system
         plugin declared in the model-level <gazebo> block above. The XML below is
         intentionally kept as a comment for reference only. -->
    <!--
    <gazebo reference="base_link">
        <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
            <left_joint>front_left_wheel_joint</left_joint>
            <right_joint>front_right_wheel_joint</right_joint>
            <wheel_separation>0.16</wheel_separation>
            <wheel_diameter>0.08</wheel_diameter>
            <max_wheel_torque>10</max_wheel_torque>
            <max_wheel_accel>1.0</max_wheel_accel>
            <command_topic>cmd_vel</command_topic>
            <odometry_topic>odom</odometry_topic>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>false</publish_odom_tf>
            <update_rate>30</update_rate>
        </plugin>
    </gazebo>
    -->

</robot>
