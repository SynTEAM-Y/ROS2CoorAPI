<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>x3plus_vision_bringup</name>
  <version>0.0.1</version>
  <description>Bringup launches for X3 Plus cameras (Astra Plus + arm cam + depth processing)</description>

  <maintainer email="karimnah01@gmail.com">Karim</maintainer>
  <license>BSD-3-Clause</license>

  <!-- Python package build; keep this even for ament_python packages -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Launch-time dependencies -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Vendor driver we wrap (from ros2_astra_camera) -->
  <exec_depend>astra_camera</exec_depend>

  <!-- Useful vision utilities you may call from your launches -->
  <exec_depend>image_proc</exec_depend>
  <exec_depend>depth_image_proc</exec_depend>

  <!-- If you'll use a USB arm camera driver from apt; harmless to keep -->
  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>usb_cam</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
