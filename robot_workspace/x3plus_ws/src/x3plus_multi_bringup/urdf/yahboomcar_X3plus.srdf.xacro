<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="yahboomcar_X3plus">
  <!-- define an arg and also mirror it into a property via $(arg ...) -->
  <xacro:arg name="prefix" default=""/>
  <xacro:property name="pfx" value="$(arg prefix)"/>

  <!-- Arm group -->
  <group name="arm_group">
    <chain base_link="${pfx}base_footprint" tip_link="${pfx}arm_link5"/>
  </group>

  <!-- Gripper group -->
  <group name="gripper_group">
    <link name="${pfx}rlink1"/>
    <link name="${pfx}rlink2"/>
    <link name="${pfx}llink1"/>
    <link name="${pfx}llink2"/>
    <link name="${pfx}llink3"/>
    <link name="${pfx}rlink3"/>
  </group>

  <!-- Arm positions -->
  <group_state name="up" group="arm_group">
    <joint name="${pfx}arm_joint1" value="0"/>
    <joint name="${pfx}arm_joint2" value="0"/>
    <joint name="${pfx}arm_joint3" value="0"/>
    <joint name="${pfx}arm_joint4" value="0"/>
    <joint name="${pfx}arm_joint5" value="0"/>
  </group_state>

  <group_state name="down" group="arm_group">
    <joint name="${pfx}arm_joint1" value="0"/>
    <joint name="${pfx}arm_joint2" value="-1.5708"/>
    <joint name="${pfx}arm_joint3" value="0"/>
    <joint name="${pfx}arm_joint4" value="0"/>
    <joint name="${pfx}arm_joint5" value="0"/>
  </group_state>

  <group_state name="init" group="arm_group">
    <joint name="${pfx}arm_joint1" value="0"/>
    <joint name="${pfx}arm_joint2" value="0.7854"/>
    <joint name="${pfx}arm_joint3" value="-1.5708"/>
    <joint name="${pfx}arm_joint4" value="-1.5708"/>
    <joint name="${pfx}arm_joint5" value="0"/>
  </group_state>

  <group_state name="state1" group="arm_group">
    <joint name="${pfx}arm_joint1" value="-1.1170"/>
    <joint name="${pfx}arm_joint2" value="-0.3316"/>
    <joint name="${pfx}arm_joint3" value="-0.2618"/>
    <joint name="${pfx}arm_joint4" value="1.0647"/>
    <joint name="${pfx}arm_joint5" value="-0.1222"/>
  </group_state>

  <group_state name="state2" group="arm_group">
    <joint name="${pfx}arm_joint1" value="-1.5184"/>
    <joint name="${pfx}arm_joint2" value="-0.4189"/>
    <joint name="${pfx}arm_joint3" value="-0.6458"/>
    <joint name="${pfx}arm_joint4" value="-0.2094"/>
    <joint name="${pfx}arm_joint5" value="-0.6632"/>
  </group_state>

  <group_state name="close" group="gripper_group">
    <joint name="${pfx}grip_joint" value="0"/>
  </group_state>
  <group_state name="open" group="gripper_group">
    <joint name="${pfx}grip_joint" value="-1.54"/>
  </group_state>

  <end_effector name="gripper" parent_link="${pfx}arm_link5" group="gripper_group" parent_group="arm_group"/>

  <!-- Disable collisions -->
  <disable_collisions link1="${pfx}arm_link1" link2="${pfx}arm_link2" reason="Adjacent"/>
  <disable_collisions link1="${pfx}arm_link1" link2="${pfx}arm_link3" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link1" link2="${pfx}arm_link4" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link1" link2="${pfx}arm_link5" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link1" link2="${pfx}base_link" reason="Adjacent"/>
  <disable_collisions link1="${pfx}arm_link1" link2="${pfx}camera_link" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link1" link2="${pfx}laser_link" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link1" link2="${pfx}llink1" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link1" link2="${pfx}llink2" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link1" link2="${pfx}llink3" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link1" link2="${pfx}rlink1" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link1" link2="${pfx}rlink2" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link1" link2="${pfx}rlink3" reason="Never"/>

  <disable_collisions link1="${pfx}arm_link2" link2="${pfx}arm_link3" reason="Adjacent"/>
  <disable_collisions link1="${pfx}arm_link2" link2="${pfx}arm_link4" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link2" link2="${pfx}arm_link5" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link2" link2="${pfx}base_link" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link2" link2="${pfx}camera_link" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link2" link2="${pfx}laser_link" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link2" link2="${pfx}llink1" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link2" link2="${pfx}llink2" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link2" link2="${pfx}llink3" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link2" link2="${pfx}mono_link" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link2" link2="${pfx}rlink1" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link2" link2="${pfx}rlink2" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link2" link2="${pfx}rlink3" reason="Never"/>

  <disable_collisions link1="${pfx}arm_link3" link2="${pfx}arm_link4" reason="Adjacent"/>
  <disable_collisions link1="${pfx}arm_link3" link2="${pfx}arm_link5" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link3" link2="${pfx}camera_link" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link3" link2="${pfx}laser_link" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link3" link2="${pfx}llink1" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link3" link2="${pfx}llink2" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link3" link2="${pfx}llink3" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link3" link2="${pfx}mono_link" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link3" link2="${pfx}rlink1" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link3" link2="${pfx}rlink2" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link3" link2="${pfx}rlink3" reason="Never"/>

  <disable_collisions link1="${pfx}arm_link4" link2="${pfx}arm_link5" reason="Adjacent"/>
  <disable_collisions link1="${pfx}arm_link4" link2="${pfx}camera_link" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link4" link2="${pfx}llink1" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link4" link2="${pfx}llink2" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link4" link2="${pfx}llink3" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link4" link2="${pfx}mono_link" reason="Adjacent"/>
  <disable_collisions link1="${pfx}arm_link4" link2="${pfx}rlink1" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link4" link2="${pfx}rlink2" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link4" link2="${pfx}rlink3" reason="Never"/>

  <disable_collisions link1="${pfx}arm_link5" link2="${pfx}llink1" reason="Adjacent"/>
  <disable_collisions link1="${pfx}arm_link5" link2="${pfx}llink2" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link5" link2="${pfx}llink3" reason="Adjacent"/>
  <disable_collisions link1="${pfx}arm_link5" link2="${pfx}mono_link" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link5" link2="${pfx}rlink1" reason="Adjacent"/>
  <disable_collisions link1="${pfx}arm_link5" link2="${pfx}rlink2" reason="Never"/>
  <disable_collisions link1="${pfx}arm_link5" link2="${pfx}rlink3" reason="Adjacent"/>

  <disable_collisions link1="${pfx}base_link" link2="${pfx}camera_link" reason="Adjacent"/>
  <disable_collisions link1="${pfx}base_link" link2="${pfx}laser_link" reason="Adjacent"/>

  <disable_collisions link1="${pfx}camera_link" link2="${pfx}laser_link" reason="Never"/>
  <disable_collisions link1="${pfx}camera_link" link2="${pfx}mono_link" reason="Never"/>

  <disable_collisions link1="${pfx}llink1" link2="${pfx}llink2" reason="Adjacent"/>
  <disable_collisions link1="${pfx}llink1" link2="${pfx}llink3" reason="Never"/>
  <disable_collisions link1="${pfx}llink1" link2="${pfx}mono_link" reason="Never"/>
  <disable_collisions link1="${pfx}llink1" link2="${pfx}rlink1" reason="Always"/>
  <disable_collisions link1="${pfx}llink1" link2="${pfx}rlink2" reason="Never"/>
  <disable_collisions link1="${pfx}llink1" link2="${pfx}rlink3" reason="Never"/>

  <disable_collisions link1="${pfx}llink2" link2="${pfx}llink3" reason="Default"/>
  <disable_collisions link1="${pfx}llink2" link2="${pfx}mono_link" reason="Never"/>
  <disable_collisions link1="${pfx}llink2" link2="${pfx}rlink1" reason="Never"/>
  <disable_collisions link1="${pfx}llink2" link2="${pfx}rlink2" reason="Never"/>
  <disable_collisions link1="${pfx}llink2" link2="${pfx}rlink3" reason="Never"/>

  <disable_collisions link1="${pfx}llink3" link2="${pfx}mono_link" reason="Never"/>
  <disable_collisions link1="${pfx}llink3" link2="${pfx}rlink1" reason="Never"/>
  <disable_collisions link1="${pfx}llink3" link2="${pfx}rlink2" reason="Never"/>
  <disable_collisions link1="${pfx}llink3" link2="${pfx}rlink3" reason="Never"/>

  <disable_collisions link1="${pfx}mono_link" link2="${pfx}rlink1" reason="Never"/>
  <disable_collisions link1="${pfx}mono_link" link2="${pfx}rlink2" reason="Never"/>
  <disable_collisions link1="${pfx}mono_link" link2="${pfx}rlink3" reason="Never"/>

  <disable_collisions link1="${pfx}rlink1" link2="${pfx}rlink2" reason="Adjacent"/>
  <disable_collisions link1="${pfx}rlink1" link2="${pfx}rlink3" reason="Never"/>
  <disable_collisions link1="${pfx}rlink2" link2="${pfx}rlink3" reason="Default"/>
</robot>
