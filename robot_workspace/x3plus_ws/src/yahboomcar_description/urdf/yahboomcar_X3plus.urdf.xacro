<?xml version="1.0" encoding="utf-8"?>
<robot name="yahboomcar_X3plus" xmlns:xacro="http://wiki.ros.org/xacro">
    <!-- Material Definitions -->
    <material name="Black">
        <color rgba="0.0 0.0 0.0 1.0"/>
    </material>
    <material name="White">
        <color rgba="0.95 0.95 0.95 1.0"/>
    </material>
    <material name="Green">
        <color rgba="0.0 0.5 0.0 1.0"/>
    </material>
    <material name="Red">
        <color rgba="1.0 0.0 0.0 1.0"/>
    </material>
    <material name="DarkGray">
        <color rgba="0.3 0.3 0.3 1.0"/>
    </material>
    
    <!-- XACRO Argument: Robot namespace for multi-robot support -->
    <!-- Default: empty string (no namespace prefix) for single robot -->
    <!-- Usage: xacro file.xacro ns:=robot1/ (for multi-robot with slash at end) -->
    <xacro:arg name="ns" default=""/>  <!-- Default empty namespace -->
    <xacro:property name="ns" value="$(arg ns)"/>
    <link name="base_footprint"/>
    <link name="imu_link"/>
    <!-- common link-->
    <xacro:macro name="common_link" params="name material path *origin">
        <link name="${name}">
            <visual>
                <geometry>
                    <mesh filename="package://yahboomcar_description/meshes/${path}/visual/${name}.STL"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <material name="${material}"/>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://yahboomcar_description/meshes/${path}/collision/${name}.STL"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </collision>
            <xacro:insert_block name="origin"/>
        </link>
    </xacro:macro>
    <!-- revolute joint-->
    <xacro:macro name="revolute_joint" params="name parent child xyz rpy axisZ lower upper">
        <joint name="${ns}/${name}" type="revolute">
            <parent link="${ns}/${parent}"/>
            <child link="${ns}/${child}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <axis xyz="0 0 ${axisZ}"/>
            <limit lower="${lower}" upper="${upper}" effort="100" velocity="3"/>
            <!-- Damping/friction added so arm joints absorb their own motion reactions
                 instead of jerking the base around in Gazebo. -->
            <dynamics damping="1.0" friction="0.5"/>
        </joint>
    </xacro:macro>

    <!-- continuous joint-->
    <xacro:macro name="continuous_joint" params="name parent child xyz rpy mimic">
        <joint name="${ns}/${name}" type="continuous">
            <parent link="${ns}/${parent}"/>
            <child link="${ns}/${child}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <axis xyz="0 0 1"/>
            <mimic joint="${ns}/grip_joint" multiplier="${mimic}"/>
            <!-- High damping/friction: Ignition does not enforce <mimic>, so without this
                 the tiny finger links spin freely from any vibration ("insect-like" motion). -->
            <dynamics damping="5.0" friction="5.0"/>
        </joint>
    </xacro:macro>

    <!-- fixed joint-->
    <xacro:macro name="fixed_joint" params="name parent child xyz rpy">
        <joint name="${ns}/${name}" type="fixed">
            <parent link="${ns}/${parent}"/>
            <child link="${ns}/${child}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
        </joint>
    </xacro:macro>

    <!-- ==================== WHEEL LINKS AND JOINTS MACROS ==================== -->
    <!-- CONFIGURABLE WHEEL PARAMETERS -->
    <!-- Wheel Radius: 0.04 = 8cm diameter wheel. Change to match your actual wheel size. -->
    <!-- Wheel Width: 0.015 = 1.5cm thickness. Adjust for wide/narrow wheels. -->
    <!-- Wheel Mass: 0.1 = 100 grams per wheel. Heavier wheels = better traction, slower response. -->
    <!-- Wheel Inertia: Automatically calculated from radius and mass (I = (1/12)*m*(3*r^2 + h^2)) -->
    
    <!-- Macro to create wheel link with simple cylinder geometry -->
    <xacro:macro name="wheel_link" params="name mass">
        <link name="${ns}/${name}">
            <inertial>
                <mass value="${mass}"/>
                <!-- WHEEL INERTIA CALCULATION: For 0.04m radius, 0.015m width, 0.1kg mass = 0.000067 -->
                <!-- Adjust these values if you change wheel radius/mass substantially -->
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <inertia ixx="0.000067" ixy="0" ixz="0" iyy="0.000067" iyz="0" izz="0.000032"/>
            </inertial>
            <visual>
                <geometry>
                    <!-- WHEEL RADIUS: Change 0.04 to your wheel radius in meters -->
                    <!-- WHEEL WIDTH: Change 0.015 to your wheel width/thickness in meters -->
                    <cylinder radius="0.04" length="0.015"/>
                </geometry>
                <origin xyz="0 0 0" rpy="1.5707 0 0"/>
                <material name="Black"/>
            </visual>
            <collision>
                <geometry>
                    <!-- WHEEL RADIUS: Must match visual radius above -->
                    <!-- WHEEL WIDTH: Must match visual width above -->
                    <cylinder radius="0.04" length="0.015"/>
                </geometry>
                <origin xyz="0 0 0" rpy="1.5707 0 0"/>
            </collision>
        </link>
    </xacro:macro>

    <!-- Macro to create wheel joint with continuous rotation for differential drive -->
    <xacro:macro name="wheel_joint" params="name parent child x_pos y_pos">
        <joint name="${ns}/${name}" type="continuous">
            <parent link="${ns}/${parent}"/>
            <child link="${ns}/${child}"/>
            <!-- WHEEL POSITION CONFIGURATION:
                 - x_pos: Forward/backward from base_link center (0.05 = 5cm forward)
                 - y_pos: Left/right position. Positive = right, negative = left
                 - Z position: Automatically set to -0.036 (wheel radius 0.04m - 0.004m clearance)
                 EDIT x_pos AND y_pos VALUES TO ADJUST WHEEL PLACEMENT -->
            <origin xyz="${x_pos} ${y_pos} -0.036" rpy="0 0 0"/>
            <!-- Rotation axis: 0 1 0 = Y-axis rotation (wheels spin side-to-side) -->
            <axis xyz="0 1 0"/>
            <!-- MOTOR TORQUE LIMIT (effort): 10 N⋅m default. Increase for more power, decrease for less. -->
            <!-- MOTOR SPEED LIMIT (velocity): 2 rad/s default. Increase for faster rotation. -->
            <limit effort="10" velocity="2"/>
            <dynamics damping="0.1" friction="0.0"/>
        </joint>
    </xacro:macro>

    <xacro:common_link name="base_link" material="Green" path="X3plus">
        <inertial>
            <origin xyz="-0.0304416859098744 4.23384368655101E-05 0.0448234503408059" rpy="0 0 0"/>
            <!-- Increased from 1.075 kg to 4.0 kg. The original CAD inertia was for the
                 chassis shell only; the real robot with battery + electronics is ~3-4 kg.
                 A heavier base resists arm-reaction torques so the robot stays put. -->
            <mass value="4.0"/>
            <inertia
                    ixx="0.078"
                    ixy="2.4618093127858E-06"
                    ixz="0.0229"
                    iyy="0.0988"
                    iyz="-1.10079499865282E-06"
                    izz="0.0482"/>
        </inertial>
    </xacro:common_link>
    <xacro:fixed_joint name="base_joint" parent="base_footprint" child="base_link" xyz="0.0 0.0 0.076" rpy="0 0 0"/>
    <xacro:fixed_joint name="base_imu" parent="base_link" child="imu_link" xyz="0.001 0.017 0.0322" rpy="0 3.1415 1.5707"/>

    <!-- ==================== 4-WHEEL DRIVE WITH STEPPER MOTORS ==================== -->
    <!-- CONFIGURABLE: Wheel Mass (kg). Default 0.1 = 100 grams each wheel -->
    <!-- Change for heavier/lighter wheels. More mass = better traction but slower acceleration -->
    <xacro:wheel_link name="front_left_wheel" mass="0.1"/>
    <xacro:wheel_link name="front_right_wheel" mass="0.1"/>
    <xacro:wheel_link name="back_left_wheel" mass="0.1"/>
    <xacro:wheel_link name="back_right_wheel" mass="0.1"/>

    <!-- CONFIGURABLE: Wheel Positions (4-wheel configuration) -->
    <!-- Front wheels: x_pos=0.05 (5cm forward - matches original 2-wheel position) -->
    <!-- Back wheels: x_pos=-0.08 (8cm backward from center) -->
    <!-- Left wheels: y_pos=0.08 (8cm to the left) -->
    <!-- Right wheels: y_pos=-0.08 (8cm to the right) -->
    <!-- Total wheelbase: 13cm, track width: 16cm -->
    <xacro:wheel_joint name="front_left_wheel_joint" parent="base_link" child="front_left_wheel" x_pos="0.1054" y_pos="0.1064"/>
    <xacro:wheel_joint name="front_right_wheel_joint" parent="base_link" child="front_right_wheel" x_pos="0.1054" y_pos="-0.1064"/>
    <xacro:wheel_joint name="back_left_wheel_joint" parent="base_link" child="back_left_wheel" x_pos="-0.1146" y_pos="0.1064"/>
    <xacro:wheel_joint name="back_right_wheel_joint" parent="base_link" child="back_right_wheel" x_pos="-0.1146" y_pos="-0.1064"/>

    <!-- GAZEBO FRICTION PROPERTIES FOR ALL 4 WHEELS -->
    <!-- mu1, mu2: Friction coefficients (0.0-1.0+). Higher = more grip. 0.8 is typical rubber on floor -->
    <!-- kp, kd: Contact stiffness and damping. Higher kp = stiffer contact, better for rigid wheels -->
    <gazebo reference="front_left_wheel">
        <material>Gazebo/Black</material>
        <mu1>1.5</mu1>
        <mu2>1.5</mu2>
        <kp>1000000.0</kp>
        <kd>1.0</kd>
    </gazebo>

    <gazebo reference="front_right_wheel">
        <material>Gazebo/Black</material>
        <mu1>1.5</mu1>
        <mu2>1.5</mu2>
        <kp>1000000.0</kp>
        <kd>1.0</kd>
    </gazebo>

    <gazebo reference="back_left_wheel">
        <material>Gazebo/Black</material>
        <mu1>1.5</mu1>
        <mu2>1.5</mu2>
        <kp>1000000.0</kp>
        <kd>1.0</kd>
    </gazebo>

    <gazebo reference="back_right_wheel">
        <material>Gazebo/Black</material>
        <mu1>1.5</mu1>
        <mu2>1.5</mu2>
        <kp>1000000.0</kp>
        <kd>1.0</kd>
    </gazebo>

    <xacro:common_link name="laser_link" material="DarkGray" path="sensor_X3plus">
        <inertial>
            <origin xyz="-0.0176558922685589 0.000671805271544437 0.0219302095894866" rpy="0 0 0"/>
            <mass value="0.0483909504209895"/>
            <inertia ixx="1.58456966399128E-05" ixy="-4.23913983850005E-07" ixz="-2.09597897904374E-07"
                     iyy="3.89262522903605E-05" iyz="3.24809725932687E-07" izz="4.86230801106223E-05"/>
        </inertial>
    </xacro:common_link>
    <xacro:fixed_joint name="laser_joint" parent="base_link" child="laser_link" xyz="0.10478 0 0.0471" rpy="0 0 0"/>
    
    <xacro:common_link name="camera_link" material="DarkGray" path="sensor_X3plus">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
    </xacro:common_link>
    <xacro:fixed_joint name="camera_joint" parent="base_link" child="camera_link" xyz="-0.043645 0 0.41955" rpy="0 0 0"/>

    <xacro:common_link name="arm_link1" material="DarkGray" path="X3plus">
        <inertial>
            <origin xyz="1.99179507982521E-05 -5.98354652829568E-05 0.0114289358828097" rpy="0 0 0"/>
            <mass value="0.0279545499871709"/>
            <inertia
                    ixx="1.19144359314975E-05"
                    ixy="-9.26068510046816E-09"
                    ixz="3.16060516198683E-09"
                    iyy="1.05642517915377E-05"
                    iyz="2.69674403668579E-08"
                    izz="1.49639510661413E-05"/>
        </inertial>
    </xacro:common_link>
    <xacro:revolute_joint name="arm_joint1" parent="base_link" child="arm_link1" xyz="0.09825 0 0.102" rpy="0 0 0" axisZ="-1"
                    lower="-${pi/2}" upper="${pi/2}"/>
    <xacro:common_link name="arm_link2" material="Green" path="X3plus">
        <inertial>
            <origin xyz="0.024903 -0.0022632 -0.00066663" rpy="0 0 0"/>
            <mass value="0.031605"/>
            <inertia
                    ixx="5.8495E-06"
                    ixy="-8.8092E-07"
                    ixz="1.5336E-07"
                    iyy="2.667E-05"
                    iyz="7.1365E-09"
                    izz="2.4695E-05"/>
        </inertial>
    </xacro:common_link>
    <xacro:revolute_joint name="arm_joint2" parent="arm_link1" child="arm_link2" xyz="0 0 0.0405"
                    rpy="-${pi/2} 0 0" axisZ="-1" lower="-${pi/2}" upper="${pi/2}"/>
    <xacro:common_link name="arm_link3" material="DarkGray" path="X3plus">
        <inertial>
            <origin xyz="0.024903 -0.0022634 -0.0013962" rpy="0 0 0"/>
            <mass value="0.031605"/>
            <inertia
                    ixx="5.8492E-06"
                    ixy="-8.8063E-07"
                    ixz="1.4331E-07"
                    iyy="2.667E-05"
                    iyz="8.9675E-09"
                    izz="2.4695E-05"/>
        </inertial>
    </xacro:common_link>
    <xacro:revolute_joint name="arm_joint3" parent="arm_link2" child="arm_link3" xyz="0 -0.0829 0" rpy="0 0 0"
                    axisZ="-1" lower="-${pi/2}" upper="${pi/2}"/>
    <xacro:common_link name="arm_link4" material="Green" path="X3plus">
        <inertial>
            <origin xyz="0.036246 0.0023413 -0.0019655" rpy="0 0 0"/>
            <mass value="0.049766"/>
            <inertia
                    ixx="1.1857E-05"
                    ixy="-6.5371E-06"
                    ixz="-4.1044E-08"
                    iyy="3.6323E-05"
                    iyz="-1.2132E-07"
                    izz="4.1769E-05"/>
        </inertial>
    </xacro:common_link>
    <xacro:revolute_joint name="arm_joint4" parent="arm_link3" child="arm_link4" xyz="0 -0.0829 0" rpy="0 0 0"
                    axisZ="-1" lower="-${pi/2}" upper="${pi/2}"/>
    <xacro:common_link name="arm_link5" material="Red" path="X3plus">
        <inertial>
            <origin xyz="0.0023228 0.018169 0.028684" rpy="0 0 0"/>
            <mass value="0.04069"/>
            <inertia
                    ixx="1.0627E-05"
                    ixy="-3.0402E-07"
                    ixz="-1.9524E-07"
                    iyy="9.6306E-06"
                    iyz="-1.3265E-06"
                    izz="1.3298E-05"/>
        </inertial>
    </xacro:common_link>
    <xacro:revolute_joint name="arm_joint5" parent="arm_link4" child="arm_link5" xyz="-0.00215 -0.17455 0"
                    rpy="${pi/2} 0 0" axisZ="1" lower="-${pi/2}" upper="${pi}"/>

    <xacro:common_link name="rlink1" material="Green" path="X3plus">
        <inertial>
            <origin xyz="0.00653227489887718 0.000416767821288678 0.000980984132845697" rpy="0 0 0"/>
            <mass value="0.00117883201961805"/>
            <inertia
                    ixx="3.30415008842026E-08"
                    ixy="8.05114594599862E-09"
                    ixz="-1.46441757999184E-10"
                    iyy="1.67254031134004E-07"
                    iyz="-9.31932225400159E-12"
                    izz="1.99277285249309E-07"/>
        </inertial>
    </xacro:common_link>
    <!-- grip_joint: inlined (NOT using revolute_joint macro) so we can apply
         very low damping/friction. The driven link rlink1 has tiny inertia
         (~1e-7 kg.m²); the macro's damping=1.0/friction=0.5 over-damps it and
         the PID controller cannot move the joint. -->
    <joint name="${ns}/grip_joint" type="revolute">
        <parent link="${ns}/arm_link5"/>
        <child link="${ns}/rlink1"/>
        <origin xyz="-0.0035 -0.012625 -0.0685" rpy="0 -${pi/2} 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-${pi/2}" upper="0" effort="100" velocity="5"/>
        <dynamics damping="0.005" friction="0.001"/>
    </joint>
    <xacro:common_link name="rlink2" material="Green" path="X3plus">
        <inertial>
            <origin xyz="0.021158 0.0063295 -0.0030251" rpy="0 0 0"/>
            <mass value="0.0024469"/>
            <inertia
                    ixx="5.188E-08"
                    ixy="-1.2303E-07"
                    ixz="-1.2978E-09"
                    iyy="6.3204E-07"
                    iyz="-3.8824E-10"
                    izz="6.6364E-07"/>
        </inertial>
    </xacro:common_link>
    <xacro:continuous_joint name="rlink_joint2" parent="rlink1" child="rlink2" xyz="0.03 -0.00075429 0" rpy="0 0 0" mimic="-1"/>

    <xacro:common_link name="rlink3" material="Green" path="X3plus">
        <inertial>
            <origin xyz="0.014355 1.1499E-05 -0.0033992" rpy="0 0 0"/>
            <mass value="0.00087627"/>
            <inertia
                    ixx="2.0534E-08"
                    ixy="-1.0235E-10"
                    ixz="1.074E-09"
                    iyy="1.4825E-07"
                    iyz="8.7073E-13"
                    izz="1.3089E-07"/>
        </inertial>
    </xacro:common_link>
    <xacro:continuous_joint name="rlink_joint3" parent="arm_link5" child="rlink3" xyz="-0.0035 -0.0045 -0.0505"
                      rpy="0 -${pi/2} 0" mimic="1"/>
    <xacro:common_link name="llink1" material="Green" path="X3plus">
        <inertial>
            <origin xyz="0.00628617364795481 -0.000318530407893543 0.00100000338924466" rpy="0 0 0"/>
            <mass value="0.00121010771282268"/>
            <inertia
                    ixx="3.18226609060835E-08"
                    ixy="-8.06236004452728E-09"
                    ixz="3.99064856025629E-14"
                    iyy="1.69267681405915E-07"
                    iyz="1.87039773440675E-14"
                    izz="2.00283878176223E-07"/>
        </inertial>
    </xacro:common_link>
    <xacro:continuous_joint name="llink_joint1" parent="arm_link5" child="llink1" xyz="-0.0035 0.012375 -0.0685"
                      rpy="0 -${pi/2} 0" mimic="-1"/>
    <xacro:common_link name="llink2" material="Green" path="X3plus">
        <inertial>
            <origin xyz="0.021159 -0.0063248 -0.0030251" rpy="0 0 0"/>
            <mass value="0.0024469"/>
            <inertia ixx="5.1826E-08" ixy="1.229E-07" ixz="-1.2979E-09" iyy="6.321E-07" iyz="3.8796E-10"
                     izz="6.6364E-07"/>
        </inertial>
    </xacro:common_link>
    <xacro:continuous_joint name="llink_joint2" parent="llink1" child="llink2" xyz="0.03 0.00065104 0" rpy="0 0 0"
                      mimic="1"/>
    <xacro:common_link name="llink3" material="Green" path="X3plus">
        <inertial>
            <origin xyz="0.014354 -7.4795E-05 -0.0033992" rpy="0 0 0"/>
            <mass value="0.00087627"/>
            <inertia ixx="2.0537E-08" ixy="6.6549E-10" ixz="1.074E-09" iyy="1.4825E-07" iyz="-5.5867E-12"
                     izz="1.3089E-07"/>
        </inertial>
    </xacro:common_link>
    <xacro:continuous_joint name="llink_joint3" parent="arm_link5" child="llink3" xyz="-0.0035 0.0045 -0.0505"
                      rpy="0 -${pi/2} 0" mimic="-1"/>

    <xacro:common_link name="mono_link" material="DarkGray" path="sensor_X3plus">
        <inertial>
            <origin xyz="5.8458E-05 0.0095015 -0.0014824" rpy="0 0 0"/>
            <mass value="0.0097589"/>
            <inertia ixx="3.3488E-06" ixy="1.3667E-08" ixz="6.4235E-09" iyy="1.8662E-06" iyz="-1.0265E-07"
                     izz="2.5696E-06"/>
        </inertial>
    </xacro:common_link>
    <xacro:fixed_joint name="mono_joint" parent="arm_link4" child="mono_link" xyz="-0.0481 -0.05145 -0.0022"
                 rpy="${pi/2} 0 0"/>

    <!-- ==================== ARM INITIAL POSITIONS FOR GAZEBO ==================== -->
    <!-- Set default joint positions to match RViz (all at 0 radians) -->
    <gazebo reference="arm_joint1">
        <implicitSpringDamper>true</implicitSpringDamper>
        <initial_position>0</initial_position>
    </gazebo>
    <gazebo reference="arm_joint2">
        <implicitSpringDamper>true</implicitSpringDamper>
        <initial_position>0</initial_position>
    </gazebo>
    <gazebo reference="arm_joint3">
        <implicitSpringDamper>true</implicitSpringDamper>
        <initial_position>0</initial_position>
    </gazebo>
    <gazebo reference="arm_joint4">
        <implicitSpringDamper>true</implicitSpringDamper>
        <initial_position>0</initial_position>
    </gazebo>
    <gazebo reference="arm_joint5">
        <implicitSpringDamper>true</implicitSpringDamper>
        <initial_position>0</initial_position>
    </gazebo>

    <!-- ==================== ARM JOINT POSITION CONTROLLERS (IGNITION) ==================== -->
    <!-- Without these, gravity makes the arm collapse on spawn.                            -->
    <!-- Each JointPositionController is a PID that holds the joint at a commanded angle.  -->
    <!-- Commands come in as ignition.msgs.Double on /<joint>_cmd_pos and are bridged from -->
    <!-- ROS std_msgs/Float64 topics published by the existing arm_controller node.        -->
    <gazebo>
        <plugin filename="ignition-gazebo-joint-position-controller-system"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>arm_joint1</joint_name>
            <topic>/arm_joint1_cmd_pos</topic>
            <p_gain>15</p_gain> <i_gain>0.3</i_gain> <d_gain>2</d_gain>
            <i_max>3</i_max> <i_min>-3</i_min>
            <cmd_max>8</cmd_max> <cmd_min>-8</cmd_min>
            <initial_position>0</initial_position>
        </plugin>
        <plugin filename="ignition-gazebo-joint-position-controller-system"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>arm_joint2</joint_name>
            <topic>/arm_joint2_cmd_pos</topic>
            <p_gain>25</p_gain> <i_gain>0.5</i_gain> <d_gain>3</d_gain>
            <i_max>5</i_max> <i_min>-5</i_min>
            <cmd_max>15</cmd_max> <cmd_min>-15</cmd_min>
            <initial_position>0</initial_position>
        </plugin>
        <plugin filename="ignition-gazebo-joint-position-controller-system"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>arm_joint3</joint_name>
            <topic>/arm_joint3_cmd_pos</topic>
            <p_gain>20</p_gain> <i_gain>0.4</i_gain> <d_gain>2.5</d_gain>
            <i_max>4</i_max> <i_min>-4</i_min>
            <cmd_max>12</cmd_max> <cmd_min>-12</cmd_min>
            <initial_position>0</initial_position>
        </plugin>
        <plugin filename="ignition-gazebo-joint-position-controller-system"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>arm_joint4</joint_name>
            <topic>/arm_joint4_cmd_pos</topic>
            <p_gain>15</p_gain> <i_gain>0.3</i_gain> <d_gain>2</d_gain>
            <i_max>3</i_max> <i_min>-3</i_min>
            <cmd_max>8</cmd_max> <cmd_min>-8</cmd_min>
            <initial_position>0</initial_position>
        </plugin>
        <plugin filename="ignition-gazebo-joint-position-controller-system"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>arm_joint5</joint_name>
            <topic>/arm_joint5_cmd_pos</topic>
            <p_gain>10</p_gain> <i_gain>0.2</i_gain> <d_gain>1.5</d_gain>
            <i_max>2</i_max> <i_min>-2</i_min>
            <cmd_max>6</cmd_max> <cmd_min>-6</cmd_min>
            <initial_position>0</initial_position>
        </plugin>
        <plugin filename="ignition-gazebo-joint-position-controller-system"
                name="ignition::gazebo::systems::JointPositionController">
            <joint_name>grip_joint</joint_name>
            <topic>/grip_joint_cmd_pos</topic>
            <p_gain>200</p_gain> <i_gain>2.0</i_gain> <d_gain>5</d_gain>
            <i_max>10</i_max> <i_min>-10</i_min>
            <cmd_max>100</cmd_max> <cmd_min>-100</cmd_min>
            <initial_position>0</initial_position>
        </plugin>
        <!-- NOTE: Mimic gripper finger joints (llink_joint1..3, rlink_joint2..3) have
             ~1e-7 kg.m^2 inertia which destabilises ODE/DART under any applied torque.
             We do NOT install JointPositionControllers on them. Gravity is disabled on
             the finger links below, so with no applied torque they remain at their
             URDF spawn pose. The gripper closure is purely visual via grip_joint;
             the finger meshes track via the URDF mimic tag in robot_state_publisher. -->
        <!-- ==================== IGNITION DIFFERENTIAL DRIVE ==================== -->
        <!-- Replaces the Gazebo-Classic libgazebo_ros_diff_drive.so plugin which is
             not loadable in Ignition Gazebo. Listens on /cmd_vel and publishes /odom + TF.
             Only the FRONT wheels are driven; the back wheels roll passively to avoid
             over-constraining the rigid base (driving all four caused ODE AABB asserts). -->
        <plugin filename="ignition-gazebo-diff-drive-system"
                name="ignition::gazebo::systems::DiffDrive">
            <left_joint>front_left_wheel_joint</left_joint>
            <right_joint>front_right_wheel_joint</right_joint>
            <wheel_separation>0.16</wheel_separation>
            <wheel_radius>0.04</wheel_radius>
            <max_linear_acceleration>3.0</max_linear_acceleration>
            <max_angular_acceleration>3.0</max_angular_acceleration>
            <max_linear_velocity>1.5</max_linear_velocity>
            <max_angular_velocity>3.0</max_angular_velocity>
            <topic>/cmd_vel</topic>
            <odom_topic>/odom</odom_topic>
            <tf_topic>/tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <odom_publish_frequency>30</odom_publish_frequency>
        </plugin>
        <!-- Publishes the actual joint positions from the physics engine so the bridge
             can forward them to ROS /joint_states (replacing the static publisher).      -->
        <plugin filename="ignition-gazebo-joint-state-publisher-system"
                name="ignition::gazebo::systems::JointStatePublisher">
            <update_rate>200</update_rate>
        </plugin>
    </gazebo>

    <!-- Disable gravity on the passive mimic gripper links so they do not flop in Gazebo.
         Mimic constraints are not enforced by Ignition physics, but with gravity off
         these links remain at their spawn pose instead of falling free.                  -->
    <gazebo reference="llink1"><gravity>0</gravity></gazebo>
    <gazebo reference="llink2"><gravity>0</gravity></gazebo>
    <gazebo reference="llink3"><gravity>0</gravity></gazebo>
    <gazebo reference="rlink1"><gravity>0</gravity></gazebo>
    <gazebo reference="rlink2"><gravity>0</gravity></gazebo>
    <gazebo reference="rlink3"><gravity>0</gravity></gazebo>


    <!-- ==================== LEGACY GAZEBO CLASSIC DIFF DRIVE (DISABLED) ==================== -->
    <!-- The old Gazebo Classic libgazebo_ros_diff_drive.so plugin is not loadable in
         Ignition Gazebo. The active wheel controller is the ignition-gazebo-diff-drive-system
         plugin declared in the model-level <gazebo> block above. The XML below is
         intentionally kept as a comment for reference only. -->
    <!--
    <gazebo reference="base_link">
        <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
            <left_joint>front_left_wheel_joint</left_joint>
            <right_joint>front_right_wheel_joint</right_joint>
            <wheel_separation>0.16</wheel_separation>
            <wheel_diameter>0.08</wheel_diameter>
            <max_wheel_torque>10</max_wheel_torque>
            <max_wheel_accel>1.0</max_wheel_accel>
            <command_topic>cmd_vel</command_topic>
            <odometry_topic>odom</odometry_topic>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>false</publish_odom_tf>
            <update_rate>30</update_rate>
        </plugin>
    </gazebo>
    -->

</robot>
